{
  "name": "mermaid-actions-preview",
  "displayName": "Mermaid Actions Preview",
  "description": "Run action: links (copy, toggle, show) declared as click lines in Mermaid diagrams, in the Markdown preview.",
  "version": "0.1.0",
  "publisher": "xorio",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onLanguage:markdown"],
  "main": "./extension.js",
  "extensionDependencies": ["bierner.markdown-mermaid"],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": ["./media/preview.js"],
    "markdown.previewStyles": ["./media/preview.css"]
  }
}
