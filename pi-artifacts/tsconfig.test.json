{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/test.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "test",
    "src/artifact/broker.ts",
    "src/chat/useChat.ts",
    "src/api.ts",
    "src/chat/Markdown.tsx",
    "shared",
    "worker/mcp",
    "worker/storage/paths.ts",
    "worker/storage/artifacts.ts",
    "worker/storage/git.ts",
    "worker/storage/memory-fs.ts",
    "worker/storage/keys.ts",
    "worker/storage/user-files.ts",
    "worker/auth/access.ts"
  ]
}
