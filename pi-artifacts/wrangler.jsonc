{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-artifacts",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React app. Everything the Worker answers itself is listed in
  // run_worker_first; any other path falls back to the SPA's index.html.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/u/*"]
  },

  // Workers AI binding. Pi's createAI() routes Claude through AI Gateway with it.
  "ai": { "binding": "AI" },

  // Artifact versions (artifacts/<id>/v<n>/…) and each user's files (users/<uid>/files/…).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "pi-artifacts" }],

  "durable_objects": {
    "bindings": [
      { "name": "CHAT", "class_name": "ChatAgent" },
      { "name": "USERS", "class_name": "UserDirectory" },
      { "name": "SANDBOX", "class_name": "Sandbox" }
    ]
  },
  "exports": {
    "ChatAgent": { "type": "durable-object", "storage": "sqlite" },
    "UserDirectory": { "type": "durable-object", "storage": "sqlite" },
    "Sandbox": { "type": "durable-object", "storage": "sqlite" }
  },

  // One Linux container per chat for run_python. See Dockerfile.
  "containers": [
    {
      "class_name": "Sandbox",
      "scheduling_policy": "durable_object",
      "images": { "sandbox": { "dockerfile": "./Dockerfile" } }
    }
  ],

  "vars": {
    // A pi-ai Cloudflare AI Gateway specifier, or a Workers AI id such as @cf/zai-org/glm-5.3-flash.
    "MODEL": "anthropic/claude-sonnet-5.5",
    "AI_GATEWAY_ID": "pi-artifacts",
    // "false" hides run_python, for running without Docker.
    "SANDBOX_ENABLED": "true",
    // "true" (in .dev.vars only) enables POST /api/dev/chats/:id/publish.
    "DEV_TOOLS": "false"
  },

  "observability": { "enabled": true }
}
