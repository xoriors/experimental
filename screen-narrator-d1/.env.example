# Liquid AI decision API key (console.liquid.ai). Needed by `pnpm bench` (d1 / d1-ultra backends) and `pnpm live`.
LIQUID_API_KEY=

# Optional: the generative-VLM baseline and the live-mode narrator. Leave unset to skip them.
# The Anthropic SDK also accepts an `ant auth login` profile instead of a key.
ANTHROPIC_API_KEY=
# Model for the generative baseline / narrator (default claude-opus-5-5).
NARRATOR_VLM_MODEL=claude-opus-5-5
# Reasoning effort for that model: low | medium | high | xhigh | max (default low — it is a classification baseline).
NARRATOR_VLM_EFFORT=low

# Pixel-diff baseline: changed-pixel fraction at which P(announce) = 0.5 (default 0.005 = 0.5 %).
PIXEL_DIFF_THRESHOLD=0.005

# Optional: d1 price per million input tokens, for cost columns (d1-ultra is $0.042; d1's price is not hardcoded).
LIQUID_D1_USD_PER_MTOK=

# Live mode port (default 5178).
LIVE_PORT=5178
