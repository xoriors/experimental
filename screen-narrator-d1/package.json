{
  "name": "screen-narrator-d1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "capture": "tsx src/capture.ts",
    "bench": "tsx src/run.ts",
    "report": "tsx src/report.ts",
    "live": "tsx src/live/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "diagrams": "for f in docs/*.mmd; do PUPPETEER_SKIP_DOWNLOAD=1 npx -y @mermaid-js/mermaid-cli -c docs/mermaid.json -p docs/pptr.json -i \"$f\" -o \"${f%.mmd}.svg\" || exit 1; done",
    "site": "tsx src/publish.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@typesafe-ai/sdk": "0.6.0",
    "pixelmatch": "^7.0.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
